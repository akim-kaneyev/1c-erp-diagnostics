Функция HealthGET(ЗапросHTTP) Экспорт

	Возврат ОтветJSON(СостояниеСервиса());

КонецФункции

Функция CommandPOST(ЗапросHTTP) Экспорт

	Попытка
		Тело = ЗапросHTTP.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		Если СтрДлина(Тело) > 65536 Тогда
			Возврат ОшибкаJSON("request_too_large", 413);
		КонецЕсли;
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Тело);
		Параметры = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
		Если ТипЗнч(Параметры) <> Тип("Соответствие") Тогда
			Возврат ОшибкаJSON("invalid_request", 400);
		КонецЕсли;
		Команда = Параметры.Получить("command");
		Если Команда = "Health" И ТолькоПоля(Параметры, "command") Тогда
			Возврат ОтветJSON(СостояниеСервиса());
		ИначеЕсли Команда = "Metadata" И ТолькоПоля(Параметры, "command,sections") Тогда
			Возврат ОтветМетаданных(Параметры.Получить("sections"));
		ИначеЕсли Команда = "Describe" И ТолькоПоля(Параметры, "command,kind,name") Тогда
			Возврат ОтветОписания(Параметры.Получить("kind"), Параметры.Получить("name"));
		ИначеЕсли Команда = "Query" И ТолькоПоля(Параметры, "command,queryId,params,limit") Тогда
			Возврат ОтветЗапроса(Параметры);
		КонецЕсли;
		Возврат ОшибкаJSON("operation_not_read_only", 403);
	Исключение
		// Never return exception details, query text, credentials or business values.
		Возврат ОшибкаJSON("read_failed_or_invalid_input", 400);
	КонецПопытки;

КонецФункции

Функция СостояниеСервиса()

	Данные = Новый Структура("ok,service,readOnly,contractVersion,bridgeVersion", Истина, "VelisReadOnlyBridge", Истина, 1, "0.1.0");
	Данные.Вставить("metadataName", Метаданные.Имя);
	Данные.Вставить("metadataVersion", Метаданные.Версия);
	Возврат Данные;

КонецФункции

Функция ТолькоПоля(Данные, Имена)

	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда Возврат Ложь; КонецЕсли;
	Поля = СтрРазделить(Имена, ",", Ложь);
	Если Данные.Количество() <> Поля.Количество() Тогда Возврат Ложь; КонецЕсли;
	Для Каждого Элемент Из Данные Цикл
		Если Поля.Найти(Элемент.Ключ) = Неопределено Тогда Возврат Ложь; КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция КоллекцияРаздела(Имя)

	Если Имя = "catalogs" Тогда Возврат Метаданные.Справочники;
	ИначеЕсли Имя = "documents" Тогда Возврат Метаданные.Документы;
	ИначеЕсли Имя = "enums" Тогда Возврат Метаданные.Перечисления;
	ИначеЕсли Имя = "informationRegisters" Тогда Возврат Метаданные.РегистрыСведений;
	ИначеЕсли Имя = "accumulationRegisters" Тогда Возврат Метаданные.РегистрыНакопления;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция ОтветМетаданных(Разделы)

	Если ТипЗнч(Разделы) <> Тип("Массив") Тогда Возврат ОшибкаJSON("invalid_sections", 400); КонецЕсли;
	Если Разделы.Количество() < 1 Или Разделы.Количество() > 5 Тогда Возврат ОшибкаJSON("invalid_sections", 400); КонецЕсли;
	Данные = Новый Структура("ok,metadataName", Истина, Метаданные.Имя);
	Для Каждого Раздел Из Разделы Цикл
		Коллекция = КоллекцияРаздела(Раздел);
		Если Коллекция = Неопределено Тогда Возврат ОшибкаJSON("invalid_sections", 400); КонецЕсли;
		Объекты = Новый Массив;
		Для Каждого ОбъектМД Из Коллекция Цикл
			Объекты.Добавить(Новый Структура("name,synonym", ОбъектМД.Имя, Строка(ОбъектМД.Синоним)));
		КонецЦикла;
		Данные.Вставить(Раздел, Объекты);
	КонецЦикла;
	Возврат ОтветJSON(Данные);

КонецФункции

Функция НайтиОбъект(Вид, Имя)

	Если ТипЗнч(Имя) <> Тип("Строка") Тогда Возврат Неопределено; КонецЕсли;
	Если СтрДлина(Имя) = 0 Или СтрДлина(Имя) > 100 Тогда Возврат Неопределено; КонецЕсли;
	Если Вид = "document" Тогда Возврат Метаданные.Документы.Найти(Имя);
	ИначеЕсли Вид = "catalog" Тогда Возврат Метаданные.Справочники.Найти(Имя);
	ИначеЕсли Вид = "enum" Тогда Возврат Метаданные.Перечисления.Найти(Имя);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция СписокРеквизитов(Реквизиты)

	Результат = Новый Массив;
	Для Каждого Реквизит Из Реквизиты Цикл
		Результат.Добавить(Новый Структура("name,synonym,type", Реквизит.Имя, Строка(Реквизит.Синоним), Строка(Реквизит.Тип)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ОтветОписания(Вид, Имя)

	ОбъектМД = НайтиОбъект(Вид, Имя);
	Если ОбъектМД = Неопределено Тогда Возврат ОшибкаJSON("metadata_object_not_found", 404); КонецЕсли;
	Реквизиты = Новый Массив;
	ТабличныеЧасти = Новый Массив;
	Если Вид <> "enum" Тогда
		Реквизиты = СписокРеквизитов(ОбъектМД.Реквизиты);
		Для Каждого ТабличнаяЧасть Из ОбъектМД.ТабличныеЧасти Цикл
			ТабличныеЧасти.Добавить(Новый Структура("name,attributes", ТабличнаяЧасть.Имя, СписокРеквизитов(ТабличнаяЧасть.Реквизиты)));
		КонецЦикла;
	КонецЕсли;
	Объект = Новый Структура("kind,name,synonym", Вид, ОбъектМД.Имя, Строка(ОбъектМД.Синоним));
	Возврат ОтветJSON(Новый Структура("ok,object,attributes,tableParts", Истина, Объект, Реквизиты, ТабличныеЧасти));

КонецФункции

Функция ОтветЗапроса(Данные)

	Параметры = Данные.Получить("params");
	Лимит = Данные.Получить("limit");
	Если ТипЗнч(Лимит) <> Тип("Число") Тогда Возврат ОшибкаJSON("invalid_limit", 400); КонецЕсли;
	Если Лимит < 1 Или Лимит > 1000 Или Лимит <> Цел(Лимит) Тогда Возврат ОшибкаJSON("invalid_limit", 400); КонецЕсли;
	Идентификатор = Данные.Получить("queryId");
	Строки = Новый Массив;
	Если Идентификатор = "probe.constant" И ТолькоПоля(Параметры, "") Тогда
		ЗапросДанных = Новый Запрос("ВЫБРАТЬ 1 КАК VROValue");
		Выборка = ЗапросДанных.Выполнить().Выбрать();
		Выборка.Следующий();
		Строки.Добавить(Новый Структура("X", Выборка.VROValue));
	ИначеЕсли Идентификатор = "probe.typed" И ТолькоПоля(Параметры, "text,number,flag") Тогда
		Текст = Параметры.Получить("text"); Число = Параметры.Получить("number"); Флаг = Параметры.Получить("flag");
		Если ТипЗнч(Текст) <> Тип("Строка") Или ТипЗнч(Число) <> Тип("Число") Или ТипЗнч(Флаг) <> Тип("Булево") Тогда
			Возврат ОшибкаJSON("invalid_parameters", 400);
		КонецЕсли;
		Если СтрДлина(Текст) > 200 Или Число < -1000000000 Или Число > 1000000000 Тогда Возврат ОшибкаJSON("invalid_parameters", 400); КонецЕсли;
		ЗапросДанных = Новый Запрос("ВЫБРАТЬ &VROText КАК VROText, &VRONumber КАК VRONumber, &VROFlag КАК VROFlag");
		ЗапросДанных.УстановитьПараметр("VROText", Текст); ЗапросДанных.УстановитьПараметр("VRONumber", Число); ЗапросДанных.УстановитьПараметр("VROFlag", Флаг);
		Выборка = ЗапросДанных.Выполнить().Выбрать(); Выборка.Следующий();
		Строки.Добавить(Новый Структура("text,number,flag", Выборка.VROText, Выборка.VRONumber, Выборка.VROFlag));
	ИначеЕсли Идентификатор = "document.header" И ТолькоПоля(Параметры, "name,uuid") Тогда
		Возврат ШапкаДокумента(Параметры);
	Иначе
		Возврат ОшибкаJSON("query_not_allowlisted", 403);
	КонецЕсли;
	Возврат ОтветJSON(Новый Структура("ok,count,rows", Истина, Строки.Количество(), Строки));

КонецФункции

Функция ЕстьСтандартныйРеквизит(ОбъектМД, Имя)

	// StandardAttributeDescriptions supports iteration, not the metadata Find method.
	Для Каждого Реквизит Из ОбъектМД.СтандартныеРеквизиты Цикл
		Если Реквизит.Имя = Имя Тогда Возврат Истина; КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ШапкаДокумента(Параметры)

	ОбъектМД = НайтиОбъект("document", Параметры.Получить("name"));
	Если ОбъектМД = Неопределено Тогда Возврат ОшибкаJSON("metadata_object_not_found", 404); КонецЕсли;
	Идентификатор = Параметры.Получить("uuid");
	Если ТипЗнч(Идентификатор) <> Тип("Строка") Тогда Возврат ОшибкаJSON("invalid_uuid", 400); КонецЕсли;
	Если СтрДлина(Идентификатор) <> 36 Тогда Возврат ОшибкаJSON("invalid_uuid", 400); КонецЕсли;
	УИД = Новый УникальныйИдентификатор(Идентификатор);
	Если НРег(Строка(УИД)) <> НРег(Идентификатор) Тогда Возврат ОшибкаJSON("invalid_uuid", 400); КонецЕсли;
	Ссылка = Документы[ОбъектМД.Имя].ПолучитьСсылку(УИД);
	Поля = "VRO.Ссылка КАК VRORef";
	Состав = Новый Соответствие;
	Состав.Вставить("Номер", "number"); Состав.Вставить("Дата", "date"); Состав.Вставить("Проведен", "posted"); Состав.Вставить("ПометкаУдаления", "deleted");
	Для Каждого Поле Из Состав Цикл
		Если ЕстьСтандартныйРеквизит(ОбъектМД, Поле.Ключ) Тогда
			Поля = Поля + ", VRO." + Поле.Ключ + " КАК VRO" + Поле.Значение;
		КонецЕсли;
	КонецЦикла;
	// Only identifiers obtained from metadata enter the template; the reference is a bound parameter.
	ЗапросДанных = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 " + Поля + " ИЗ Документ." + ОбъектМД.Имя + " КАК VRO ГДЕ VRO.Ссылка = &VRORef");
	ЗапросДанных.УстановитьПараметр("VRORef", Ссылка);
	Выборка = ЗапросДанных.Выполнить().Выбрать();
	Строки = Новый Массив;
	Если Выборка.Следующий() Тогда
		СтрокаДанных = Новый Структура("ref", Строка(Выборка.VRORef.УникальныйИдентификатор()));
		Для Каждого Поле Из Состав Цикл
			Если ЕстьСтандартныйРеквизит(ОбъектМД, Поле.Ключ) Тогда
				Значение = Выборка["VRO" + Поле.Значение];
				Если ТипЗнч(Значение) = Тип("Дата") Тогда Значение = Формат(Значение, "ДФ=yyyy-MM-dd'T'HH:mm:ss"); КонецЕсли;
				СтрокаДанных.Вставить(Поле.Значение, Значение);
			КонецЕсли;
		КонецЦикла;
		Строки.Добавить(СтрокаДанных);
	КонецЕсли;
	Возврат ОтветJSON(Новый Структура("ok,count,rows", Истина, Строки.Количество(), Строки));

КонецФункции

Функция ОшибкаJSON(Код, Статус)

	Возврат ОтветJSON(Новый Структура("ok,reason", Ложь, Код), Статус);

КонецФункции

Функция ОтветJSON(Данные, Статус = 200)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Тело = Запись.Закрыть();
	Если СтрДлина(Тело) > 1000000 Тогда
		Тело = "{""ok"":false,""reason"":""response_too_large""}";
		Статус = 413;
	КонецЕсли;
	Ответ = Новый HTTPСервисОтвет(Статус);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.Заголовки.Вставить("Cache-Control", "no-store");
	Ответ.Заголовки.Вставить("X-Content-Type-Options", "nosniff");
	Ответ.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;

КонецФункции
